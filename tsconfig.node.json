{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "target": "ES2022"
  },
  "include": [
    "vite.config.ts",
    "scripts/**/*.ts",
    "netlify/functions/**/*.ts",
    "db/**/*.ts",
    "lib/**/*.ts"
  ]
}
