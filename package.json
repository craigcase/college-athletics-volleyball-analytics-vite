{
  "name": "college-athletics-volleyball-analytics-vite",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build:client && tsx scripts/local-dev-server.ts",
    "build:client": "vite build",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:core": "rm -rf .core-dist && tsc -p tsconfig.core.json && node --test tests/core/*.test.mjs",
    "test": "npm run test:core",
    "verify": "npm test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "tsx": "^4.20.6"
  }
}
